# Keep the entire /design folder out of search engines.
# X-Robots-Tag applies even when a page is reached by a direct link,
# and covers non-HTML files (JS, JSON, the PHP endpoint) too.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Never serve the API key file (dotfile or the visible apikey.txt) over the web.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files "apikey.txt">
  Require all denied
</Files>
<Files "airtable.json">
  Require all denied
</Files>
