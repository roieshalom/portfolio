# Serve extensionless URLs (e.g. /design/paper/eqcapture -> eqcapture.html)
# so case-study links can drop the .html. noindex is inherited from
# /design/.htaccess.
RewriteEngine On
RewriteBase /design/paper/

# If the request isn't an existing file or directory but <name>.html exists,
# serve that file (URL stays extensionless, so relative CSS/asset paths still
# resolve against /design/paper/).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
