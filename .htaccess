AddHandler application/x-httpd-php .phtml

RewriteEngine On
RewriteRule ^in$ in.php [L]

# Serve extensionless URLs (e.g. /wayfair -> wayfair.html) so case-study links
# can drop the .html. Only rewrites when the request isn't a real file/dir and
# <name>.html exists, so real files, directories (like /old) and PHP are untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Always revalidate HTML so visitors get the current pages (keeps analytics
# scripts and content fresh instead of serving a stale cached copy).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
